<Project Sdk="Microsoft.NET.Sdk">

  <!-- The freeze probe: a small program outside the game that says where a Bannerlord process's main thread is
       stuck, in the engine and in the game's own code. The Bannerlord Agents module starts it when the game's thread
       stops moving for 20 s (and agents.probe runs it on demand; scripts\probe.ps1 by hand). It lives in the module's
       probe folder, which the game never loads from. Runs on any .NET 8 or newer (RollForward). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ProbeStage>$(RepoRoot)build\Modules\BannerlordAgents\probe</ProbeStage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
  </ItemGroup>

  <!-- Copy the runnable program into the staged module, beside bin\ (the game loads nothing from probe\). -->
  <Target Name="StageProbe" AfterTargets="Build">
    <ItemGroup>
      <ProbeFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ProbeFiles)" DestinationFiles="@(ProbeFiles->'$(ProbeStage)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Freeze probe staged at $(ProbeStage)" />
  </Target>

</Project>
