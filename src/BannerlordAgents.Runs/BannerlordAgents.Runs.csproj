<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test runs' watcher and reports (docs/RUNS.md): reads what the bridge writes for each run (runs\(id)\) and the war rooms'
       call logs, and says what is new since the last look (watch), where a run stands (status), its numbers in full (report),
       every run side by side (compare), and since 0.13 packs a run's whole record for the dataset builder (bundle) and marks
       your old records made in runs an agent commanded (marks). It only reads, except its own report, bundle and marks files;
       the game and the agents never see it. Staged into the module's runs folder (the game loads nothing from there), so the
       bridge can pack a run's bundle the moment the run ends. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Runs</AssemblyName>
    <RootNamespace>BannerlordAgents.Runs</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.13.0</Version>
    <RunsStage>$(RepoRoot)build\Modules\BannerlordAgents\runs</RunsStage>
  </PropertyGroup>

  <!-- Copy the runnable program into the staged module, beside bin\ (the game loads nothing from runs\). -->
  <Target Name="StageRuns" AfterTargets="Build">
    <ItemGroup>
      <RunsFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(RunsFiles)" DestinationFiles="@(RunsFiles->'$(RunsStage)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Runs staged at $(RunsStage)" />
  </Target>

</Project>
