<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bannerlord Agents: the game module (the bridge) for the CS 329M project.
       Its own module, separate from TFAOMFixes: own DLL, own settings, own logs, no shared code.
       Built against Bannerlord 1.4.8, the version TAOM 2.0.26 requires. -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BannerlordAgents</AssemblyName>
    <RootNamespace>BannerlordAgents</RootNamespace>
    <Version>0.13.8</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ModuleId>BannerlordAgents</ModuleId>
    <ModuleStage>$(RepoRoot)build\Modules\$(ModuleId)</ModuleStage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/SmokeTest runs the worker's half (views, pokes, reports, records) outside the game -->
    <InternalsVisibleTo Include="SmokeTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the game's marching rule, one file shared with the way-finder (src/Common, docs/ROUTES.md) -->
    <Compile Include="..\Common\GamePace.cs" Link="Common\GamePace.cs" />
    <Compile Include="..\Common\GameBattle.cs" Link="Common\GameBattle.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the tool library (docs/TOOLS.md): the behavior language's tools, built into the DLL -->
    <EmbeddedResource Include="Tools\Library\*.json" />
  </ItemGroup>

  <!-- The game's own assemblies, read from the local install and never copied (Private=false). -->
  <ItemGroup>
    <Reference Include="TaleWorlds.Library" HintPath="$(GameBin)\TaleWorlds.Library.dll" Private="false" />
    <Reference Include="TaleWorlds.Core" HintPath="$(GameBin)\TaleWorlds.Core.dll" Private="false" />
    <Reference Include="TaleWorlds.CampaignSystem" HintPath="$(GameBin)\TaleWorlds.CampaignSystem.dll" Private="false" />
    <Reference Include="TaleWorlds.MountAndBlade" HintPath="$(GameBin)\TaleWorlds.MountAndBlade.dll" Private="false" />
    <!-- the game's chat box, for the lieutenant (0.10): MPChatVM and its channels -->
    <Reference Include="TaleWorlds.MountAndBlade.ViewModelCollection" HintPath="$(GameBin)\TaleWorlds.MountAndBlade.ViewModelCollection.dll" Private="false" />
    <Reference Include="TaleWorlds.MountAndBlade.Diamond" HintPath="$(GameBin)\TaleWorlds.MountAndBlade.Diamond.dll" Private="false" />
    <!-- the lieutenant's window (0.10.1): a screen layer of the game's own UI -->
    <Reference Include="TaleWorlds.Engine.GauntletUI" HintPath="$(GameBin)\TaleWorlds.Engine.GauntletUI.dll" Private="false" />
    <Reference Include="TaleWorlds.GauntletUI" HintPath="$(GameBin)\TaleWorlds.GauntletUI.dll" Private="false" />
    <Reference Include="TaleWorlds.ScreenSystem" HintPath="$(GameBin)\TaleWorlds.ScreenSystem.dll" Private="false" />
    <Reference Include="TaleWorlds.InputSystem" HintPath="$(GameBin)\TaleWorlds.InputSystem.dll" Private="false" />
    <Reference Include="TaleWorlds.DotNet" HintPath="$(GameBin)\TaleWorlds.DotNet.dll" Private="false" />
    <Reference Include="TaleWorlds.Engine" HintPath="$(GameBin)\TaleWorlds.Engine.dll" Private="false" />
    <Reference Include="TaleWorlds.SaveSystem" HintPath="$(GameBin)\TaleWorlds.SaveSystem.dll" Private="false" />
    <Reference Include="TaleWorlds.ObjectSystem" HintPath="$(GameBin)\TaleWorlds.ObjectSystem.dll" Private="false" />
    <Reference Include="TaleWorlds.Localization" HintPath="$(GameBin)\TaleWorlds.Localization.dll" Private="false" />
    <Reference Include="TaleWorlds.ModuleManager" HintPath="$(GameBin)\TaleWorlds.ModuleManager.dll" Private="false" />
    <!-- Harmony 2.4.2 as bundled by TAOM.Dependencies, the only Harmony in this install. Used only by GameHooks (the two
         hooks of the logs); if it is missing at run time, those two switch themselves off and nothing else is affected. -->
    <Reference Include="0Harmony" HintPath="$(BannerlordDir)\Modules\TAOM.Dependencies\bin\Win64_Shipping_Client\0Harmony.dll" Private="false" />
    <!-- The game ships Newtonsoft.Json 13.0.1 in its own bin; use that copy and never ship another. -->
    <Reference Include="Newtonsoft.Json" HintPath="$(GameBin)\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameBin)\TaleWorlds.Library.dll')"
           Text="Bannerlord was not found at '$(BannerlordDir)'. Copy GamePath.props.example to GamePath.props in the repository root and set BannerlordDir to your game folder." />
  </Target>

  <!-- Lay the module out the way the game expects it, under build\Modules\BannerlordAgents.
       scripts\deploy.ps1 copies that folder into the game (and refuses while the game is open). -->
  <Target Name="StageModule" AfterTargets="Build">
    <ItemGroup>
      <ModuleBinaries Include="$(TargetPath)" />
      <ModuleBinaries Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <!-- the game's screens the module brings (0.10: the chat log with its typing line, for the lieutenant) -->
      <ModuleGui Include="module\GUI\**\*.xml" />
    </ItemGroup>
    <Copy SourceFiles="module\SubModule.xml" DestinationFolder="$(ModuleStage)" />
    <Copy SourceFiles="@(ModuleBinaries)" DestinationFolder="$(ModuleStage)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="@(ModuleGui)" DestinationFiles="@(ModuleGui->'$(ModuleStage)\GUI\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Module staged at $(ModuleStage)" />
  </Target>

</Project>
