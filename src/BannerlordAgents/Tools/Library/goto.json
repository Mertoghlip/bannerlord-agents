{
  "tool": "goto",
  "kind": "move",
  "about": "Goes to a holding: inside if it is yours or an ally's, otherwise it stops close to it.",
  "at": "any_holding",
  "start": "pick",
  "states": {
    "pick": { "about": "setting out for {at}", "do": "hold",
      "when": [
        { "if": "friendly(at)", "go": "go_in" },
        { "if": "true", "go": "go_near" } ] },
    "go_in": { "about": "going to {at}", "do": "goto at",
      "when": [ { "if": "inside(at)", "go": "there", "poke": "{me} reached {at}." } ] },
    "go_near": { "about": "going close to {at}", "do": "near at",
      "when": [ { "if": "within(at, 4)", "go": "there", "poke": "{me} reached {at}." } ] },
    "there": { "about": "at {at}", "end": "hold" }
  }
}
