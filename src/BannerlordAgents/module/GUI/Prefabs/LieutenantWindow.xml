<Prefab>
  <!-- Bannerlord Agents (0.10.1; scrolling since 0.10.3): the lieutenant's window, in the look of the game's own text pop-up
       (Native\GUI\Prefabs\Information\Inquiries\TextQueryPopup.xml): its title, the conversation (everything since the load,
       newest at the bottom, scrolled with the wheel or the bar as the game's chat log is, SPChatLog.xml; the bar in the look of
       MultiSelectionQueryPopup.xml's), the proposal waiting with Decline and Approve (its list scrolls when long), the line to
       type in (focused when the window opens), and Close and Send. LieutenantWindow.cs opens it with Enter on the campaign map
       and finds LinesScrollbar by its Id to follow the newest line; the data is LieutenantVM. -->
  <Window>
    <TextQueryParentWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" TextInputWidget="Panel\Content\InputParent\InputWidget">
      <Children>

        <!-- the map behind, darkened -->
        <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.4" />

        <Widget Id="Panel" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="780" SuggestedHeight="780" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas" />

            <ListPanel Id="Content" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>

                <!--Title-->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" MarginLeft="30" MarginRight="30" MarginTop="10" Brush="Popup.Title.Text" Text="@TitleText" />
                <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="23" Sprite="StdAssets\Popup\divider" />

                <!--The conversation: everything since the load, newest at the bottom; it takes the room the rest leaves and scrolls
                    (the wheel over it, or the bar on its right)-->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="34" MarginRight="24" MarginTop="8">
                  <Children>
                    <ScrollablePanel Id="LinesPanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="20" AutoHideScrollBars="true" ReverseInitialScrollBarAlignment="true" VerticalAlignment="Bottom" ClipRect="ClipRect" InnerPanel="ClipRect\LinesList" VerticalScrollbar="..\LinesScrollbar">
                      <Children>
                        <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="LinesList" DataSource="{Lines}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Bottom" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="8" Brush="Popup.Description.Text" Brush.FontSize="20" Brush.FontColor="@Color" Brush.TextHorizontalAlignment="Left" Text="@Text" />
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <ScrollbarWidget Id="LinesScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" VerticalAlignment="Top" AlignmentAxis="Vertical" Handle="LinesScrollbarHandle" MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#5A4033FF" AlphaFactor="0.5" />
                        <ImageWidget Id="LinesScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="10" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>

                <!--While it thinks-->
                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" MarginLeft="34" MarginRight="34" Brush="Popup.Description.Text" Brush.FontSize="18" Brush.TextHorizontalAlignment="Left" Text="@ThinkingText" />

                <!--The proposal waiting, answered in words; its list scrolls when long-->
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="34" MarginRight="24" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasProposal">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="130">
                      <Children>
                        <ScrollablePanel Id="ProposalPanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="20" AutoHideScrollBars="true" ClipRect="ClipRect" InnerPanel="ClipRect\ProposalList" VerticalScrollbar="..\ProposalScrollbar">
                          <Children>
                            <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                              <Children>
                                <RichTextWidget Id="ProposalList" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Description.Text" Brush.FontSize="18" Brush.TextHorizontalAlignment="Left" Text="@ProposalText" />
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>
                        <ScrollbarWidget Id="ProposalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" VerticalAlignment="Top" AlignmentAxis="Vertical" Handle="ProposalScrollbarHandle" MaxValue="100" MinValue="0">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#5A4033FF" AlphaFactor="0.5" />
                            <ImageWidget Id="ProposalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="10" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" />
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </Widget>
                    <!--Approve and Decline are gone (0.13.8, Mert, Oct 29): the ruler answers the proposal in words-->
                  </Children>
                </ListPanel>

                <!--The line to type in-->
                <Widget Id="InputParent" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="700" SuggestedHeight="62" HorizontalAlignment="Center" MarginTop="10" Sprite="General\CharacterCreation\name_input_area">
                  <Children>
                    <EditableTextWidget Id="InputWidget" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="16" MarginRight="16" MarginTop="12" MarginBottom="12" Brush="Review.NameInput.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Left" RealText="@InputText" MaxLength="400" />
                  </Children>
                </Widget>
                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" MarginLeft="34" MarginRight="34" MarginTop="4" Brush="Popup.Description.Text" Brush.FontSize="15" Text="@HintText" />

                <!--Close and Send-->
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="4" MarginBottom="18" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="251" SuggestedHeight="64" Brush="Popup.Cancel.Button" Command.Click="ExecuteClose">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" VerticalAlignment="Center" MarginLeft="40" MarginRight="40" Brush="Popup.Button.Text" Text="@CloseText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="251" SuggestedHeight="64" MarginLeft="20" Brush="Popup.Done.Button" Command.Click="ExecuteSend">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" VerticalAlignment="Center" MarginLeft="40" MarginRight="40" Brush="Popup.Button.Text" Text="@SendText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

              </Children>
            </ListPanel>

            <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" IsEnabled="false" />
            <!--Frame Border-->
            <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" IsEnabled="false" />
          </Children>
        </Widget>

      </Children>
    </TextQueryParentWidget>
  </Window>
</Prefab>
