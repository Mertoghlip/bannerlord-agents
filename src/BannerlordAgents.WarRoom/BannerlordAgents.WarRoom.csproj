<Project Sdk="Microsoft.NET.Sdk">

  <!-- The war room: the program beside the game where the agent decides (docs/PLAN.md, decisions 6 to 8; docs/WARROOM.md).
       For every poke it starts one fresh, short Claude Code call on the player's subscription (no API key), hands it the
       agent's instructions, the order library, the journal and the poke, and writes the orders back into the agent channel.
       It runs at below-normal priority with efficiency mode, so Windows keeps it on the efficiency cores. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WarRoom</AssemblyName>
    <RootNamespace>BannerlordAgents.WarRoom</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.18.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BannerlordAgents.Routes\BannerlordAgents.Routes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- "check a tool" (0.13, docs/PLAN-0.13.md A4): the game module's own checker, which needs no game, with our tools' library to know
         their names; the same JSON reader the game ships (13.0.1) -->
    <Compile Include="..\BannerlordAgents\Tools\Expr.cs" Link="Tools\Expr.cs" />
    <Compile Include="..\BannerlordAgents\Tools\ToolDef.cs" Link="Tools\ToolDef.cs" />
    <EmbeddedResource Include="..\BannerlordAgents\Tools\Library\*.json" LogicalName="BannerlordAgents.Tools.Library.%(Filename)%(Extension)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

</Project>
