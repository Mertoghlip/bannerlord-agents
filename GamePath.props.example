       the one that holds bin\ and Modules\. GamePath.props stays on your computer; git ignores it. -->
  <PropertyGroup>
    <BannerlordDir>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordDir>
  </PropertyGroup>
</Project>
